# CARTO raster basemap key — https://carto.com/basemaps/apikey
# Needed for Midnight Dark, Minimal White, and Modern Voyager (Leaflet) themes.
# Copy this file to .env and fill in the value. Do not commit .env.
# Vite inlines VITE_* variables into the client bundle at build time.
VITE_CARTO_API_KEY=
